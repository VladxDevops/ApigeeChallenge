<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<TargetEndpoint name="default">
    <Description>Southbound Target Endpoint pointing to Cloud Run internal load balancer via PSC endpoint attachment</Description>
    <FaultRules/>
    <PreFlow name="PreFlow">
        <Request/>
        <Response/>
    </PreFlow>
    <PostFlow name="PostFlow">
        <Request/>
        <Response/>
    </PostFlow>
    <Flows/>
    <HTTPTargetConnection>
        <!-- The URL domain host uses the Apigee Endpoint Attachment host provisioned for Cloud Run PSC attachment -->
        <URL>https://cloudrun-backend.internal/hello</URL>
    </HTTPTargetConnection>
</TargetEndpoint>
